Screen {
    background: #09090b;
    color: #f4f4f5;
    align-horizontal: center;
}

#workspace {
    width: 92%;
    max-width: 112;
    height: 100%;
    margin: 0;
    padding: 1 2;
}

#topbar {
    width: 100%;
    height: 3;
    border-bottom: solid #27272a;
}

#brand {
    width: 1fr;
    height: 3;
    text-align: center;
    text-style: bold;
    color: #1DA1F2;
    padding-top: 1;
}

#status {
    display: none;
}

#idle-view {
    width: 100%;
    height: 1fr;
    align: center middle;
    padding-bottom: 2;
}

#running-view,
#complete-view,
#error-view {
    display: none;
    height: 1fr;
}

#prompt-section {
    width: 82%;
    max-width: 84;
    height: auto;
    margin: 1 0 2 0;
}

#prompt-title {
    height: 2;
    text-align: center;
    text-style: bold;
    color: #fafafa;
}

#query-input {
    height: 3;
    background: #111113;
    color: #fafafa;
    border: none;
    border-bottom: solid #3f3f46;
    padding: 0 2;
    margin-top: 1;
}

#query-input:focus {
    border-bottom: solid #1DA1F2;
}

.section-label {
    width: 82%;
    max-width: 84;
    height: 2;
    margin: 0;
    color: #71717a;
    text-style: bold;
}

#sources-container {
    width: 82%;
    max-width: 84;
    height: auto;
    align-horizontal: center;
    background: transparent;
    margin-top: 1;
}

#source-badge {
    width: 100%;
    height: 3;
    background: transparent;
    border: round #3f3f46;
    text-align: center;
    margin-bottom: 1;
}

#sources {
    width: 100%;
    height: 2;
    margin: 0;
    padding: 0;
    text-align: center;
    background: transparent;
}

#sources:focus {
    background: transparent;
}

.quiet-hint {
    width: 100%;
    height: 2;
    margin-top: 2;
    text-align: center;
    color: #52525b;
}

#running-view {
    padding: 3 8 1 8;
    align-horizontal: center;
}

#active-source {
    height: 4;
    text-align: center;
    text-style: bold;
    color: #fafafa;
}

#pipeline {
    width: 70%;
    max-width: 72;
    height: auto;
    min-height: 8;
    margin: 1 0 2 0;
    padding: 1 2;
}

#candidate {
    width: 78%;
    max-width: 82;
    height: auto;
    min-height: 7;
    margin: 1 0;
    padding: 1 2;
    border-left: solid #1DA1F2;
    background: #111113;
}

#candidate.confirming {
    border-left: solid #38bdf8;
    background: #0f172a;
}

#complete-view {
    padding: 2 7 1 7;
    align-horizontal: center;
}

#result-summary {
    height: 3;
    text-align: center;
    color: #71717a;
}

#post {
    width: 90%;
    max-width: 94;
    height: 1fr;
    margin: 0;
}

#post-title {
    height: 2;
    text-align: center;
    color: #1DA1F2;
    text-style: bold;
}

#variant-tabs {
    height: 2;
    text-align: center;
    color: #71717a;
}

#post-card {
    height: 1fr;
    min-height: 10;
    max-height: 22;
    margin: 1 0;
    padding: 2 3 1 3;
    border: round #3f3f46;
    background: #111113;
}

#post-content {
    height: 1fr;
    color: #f4f4f5;
}

#post-editor {
    height: 1fr;
    border: none;
    background: #111113;
    color: #f4f4f5;
    padding: 0;
}

#post-editor:focus {
    border: none;
}

#character-counter {
    height: 1;
    text-align: right;
    color: #71717a;
}

#character-counter.over-limit {
    color: #f59e0b;
    text-style: bold;
}

#post-actions {
    height: 3;
    padding-top: 1;
    text-align: center;
    color: #a1a1aa;
}

#error-view {
    align: center middle;
    padding-bottom: 5;
}

#error-title {
    width: 70%;
    height: 3;
    text-align: center;
    color: #ef4444;
    text-style: bold;
}

#error-message {
    width: 70%;
    max-width: 72;
    height: auto;
    min-height: 4;
    text-align: center;
    color: #d4d4d8;
}

#error-actions {
    width: 70%;
    height: 3;
    padding-top: 1;
    text-align: center;
    color: #a1a1aa;
}

#debug-hint {
    height: 1;
    text-align: right;
    color: #3f3f46;
}

DebugScreen {
    align: center middle;
    background: #09090bcc;
}

#debug-dialog {
    width: 88%;
    height: 80%;
    padding: 1 2;
    border: round #3f3f46;
    background: #111113;
}

#debug-title {
    height: 2;
    color: #1DA1F2;
    text-style: bold;
}

#debug-content {
    color: #a1a1aa;
}

#debug-close {
    height: 2;
    padding-top: 1;
    text-align: right;
    color: #71717a;
}

.presentation #workspace {
    width: 88%;
    max-width: 104;
    padding: 2 3;
}

.presentation #debug-hint {
    display: none;
}

.presentation #idle-view {
    padding-bottom: 6;
}

.presentation #prompt-title {
    height: 4;
    padding-top: 1;
}

.presentation #query-input {
    height: 4;
    padding: 1 2;
}

.presentation #running-view {
    padding: 5 10 2 10;
}

.presentation #active-source {
    height: 5;
    padding-top: 1;
}

.presentation #complete-view {
    padding: 3 8;
}

.presentation #post-card {
    min-height: 13;
    padding: 3 4 2 4;
}

.compact #workspace {
    width: 100%;
    padding: 0 1;
}

.compact #debug-hint,
.compact .quiet-hint {
    display: none;
}

.compact #prompt-section,
.compact #sources,
.compact #sources-container,
.compact .section-label,
.compact #pipeline,
.compact #candidate,
.compact #post {
    width: 96%;
}

.compact #idle-view,
.compact #running-view,
.compact #complete-view {
    padding: 1 1;
}

.compact #prompt-section {
    margin: 1 0;
}

.compact #candidate {
    min-height: 5;
}

.compact #post-card {
    min-height: 8;
    padding: 1 2;
}
