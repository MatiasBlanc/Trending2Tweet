# Trending2Tweet - Variables de entorno
# Copiar este archivo como .env y completar con tus credenciales

# GitHub API
GITHUB_TOKEN=

# LLM (OpenAI compatible)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Para Azure AI Foundry (OpenAI-compatible): https://{recurso}.services.ai.azure.com/openai/v1
# Para Azure OpenAI (clásico): https://{recurso}.openai.azure.com/openai/deployments/{deploy}
# Solo para Azure OpenAI (clásico): versión de API obligatoria.
# El endpoint /openai/v1 de AI Foundry NO acepta api-version (400 "API version not supported").
LLM_API_VERSION=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
# true = usar max_completion_tokens en lugar de max_tokens (requerido por gpt-5.x)
LLM_USE_MAX_COMPLETION_TOKENS=false

# LLM para procesar la información antes de redactar (opcional)
# Por ejemplo, OpenRouter + DeepSeek para reducir el coste de entrada.
# Si la clave queda vacía, se reutiliza el LLM principal.
INPUT_LLM_API_KEY=
INPUT_LLM_BASE_URL=https://openrouter.ai/api/v1
INPUT_LLM_MODEL=deepseek/deepseek-chat
INPUT_LLM_MAX_TOKENS=1024
INPUT_LLM_TEMPERATURE=0.7
INPUT_LLM_API_VERSION=
INPUT_LLM_USE_MAX_COMPLETION_TOKENS=false

# Obsidian Vault
OBSIDIAN_VAULT_PATH=

# Control de tweets
# false = tweets de cualquier largo (X Premium, por defecto)
# true = tweets limitados a 280 caracteres (modo estándar)
FORCE_280_CHAR_TWEET=false

# Noticias
NEWS_SOURCE=hacker_news
NEWS_LIMIT=5
# Historias que se consultan para encontrar una noticia tech válida.
NEWS_FETCH_LIMIT=20
NEWS_MIN_SCORE=50

# Base de datos
METRICS_DB_PATH=metrics.db

# Sincronización con Railway
# true = los items procesados localmente se registran en la DB de Railway
# (volume /data) para que el scheduler no los vuelva a publicar.
RAILWAY_SYNC_ENABLED=true
RAILWAY_SSH_TIMEOUT=45

# Twitter API
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Timezone para scheduler (Chile: UTC-4)
PUBLISH_TIMEZONE_OFFSET=-4
