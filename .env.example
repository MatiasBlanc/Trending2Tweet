# Trending2Tweet - Variables de entorno
# Copiar este archivo como .env y completar con tus credenciales

# GitHub API (https://github.com/settings/tokens)
GITHUB_TOKEN=

# LLM (OpenAI compatible / Azure OpenAI / OpenRouter / DeepSeek)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_API_VERSION=
LLM_USE_MAX_COMPLETION_TOKENS=false

# LLM secundario / entrada (opcional, ej. OpenRouter + DeepSeek)
INPUT_LLM_API_KEY=
INPUT_LLM_BASE_URL=https://openrouter.ai/api/v1
INPUT_LLM_MODEL=deepseek/deepseek-chat
INPUT_LLM_MAX_TOKENS=1024
INPUT_LLM_TEMPERATURE=0.7
INPUT_LLM_API_VERSION=
INPUT_LLM_USE_MAX_COMPLETION_TOKENS=false

# Obsidian Vault
# OBSIDIAN_VAULT_PATH: carpeta de trabajo para bots (teclado/, github/, news/, codigo/, archivados/)
# Por defecto: ~/Obsidian/Twitter/bot/
OBSIDIAN_VAULT_PATH=~/Obsidian/Twitter/bot/
# TWITTER_VAULT_PATH (opcional): raíz completa de la bóveda de Twitter para 'mejorar tweet'
# Por defecto toma el directorio padre de OBSIDIAN_VAULT_PATH si termina en /bot
TWITTER_VAULT_PATH=~/Obsidian/Twitter/

# Control de tweets
# false = tweets largos (requiere X Premium)
# true  = tweets limitados a 280 caracteres
FORCE_280_CHAR_TWEET=false

# Fuentes de noticias (Hacker News)
NEWS_SOURCE=hacker_news
NEWS_LIMIT=5
NEWS_FETCH_LIMIT=20
NEWS_MIN_SCORE=50

# Base de datos local SQLite para evitar duplicados
METRICS_DB_PATH=metrics.db

# Twitter API (solo necesario si vas a publicar directamente desde el bot)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
